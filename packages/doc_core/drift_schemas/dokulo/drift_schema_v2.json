  "fixed_sql": [
    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"parent_id\" INTEGER REFERENCES folders(id)ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"colour_tag\" TEXT);"
        }
      ]
    },
    {
      "name": "files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"files\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"pages\" INTEGER NOT NULL DEFAULT 0, \"created\" INTEGER NOT NULL, \"modified\" INTEGER NOT NULL, \"has_text\" INTEGER NOT NULL DEFAULT FALSE, \"encrypted\" INTEGER NOT NULL DEFAULT FALSE, \"folder_id\" INTEGER REFERENCES folders(id)ON DELETE SET NULL, \"colour\" TEXT);"
        }
      ]
