<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (DK-0073): the system splash shows the symbol on
     color.background, no branding image, then the first Flutter frame. -->
<resources>
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/dk_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- The splash stays behind Flutter until its first frame covers it
             (DK-0073): no blank gap. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
