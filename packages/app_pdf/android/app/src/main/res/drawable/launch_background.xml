<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12 (DK-0073): color.background with
     the symbol, 72 dp, centred: what the first Flutter frame shows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dk_background" />
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/launch_symbol"
        android:gravity="center" />
</layer-list>
